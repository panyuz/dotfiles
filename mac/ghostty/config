# Ghostty config — macOS + Herdr + OMP（唯一配置源，2026-08-21 整合）
# 旧 ~/Library/Application Support/com.mitchellh.ghostty/config 已并入本文件并删除
# 职责划分：Ghostty 只做渲染；分屏/标签/窗口管理交给 Herdr（prefix 键）
#
# 2026-10-16 实测：改完本文件后，运行中的 Ghostty 不会自己生效，要手动重载：
#   Ghostty 里按 ⌘⇧,（reload_config，默认键位）或菜单 Ghostty → Reload Configuration。
#   怀疑原因：本文件是 symlink（~/.config/ghostty/config → dotfiles），文件监视看不到改动。
#   另外：窗口级设置（macos-titlebar-style、玻璃）即使重载也只对新开的窗口生效。

# ── 字体（Maple Mono NF CN：Nerd Font 图标 + 中文渲染，维持原生效值）──
font-family      = Maple Mono NF CN
font-size        = 14
font-thicken     = true
adjust-cell-height = 0
font-feature     = calt

# ── 主题：Catppuccin Mocha（与 herdr 的 catppuccin 同步；固定暗色不随系统切亮）──
# 注：window-theme=auto 只影响 macOS 标题栏亮暗，终端配色固定
# 2026-10-16：Rose Pine → Catppuccin Mocha，为了复刻参考图。对照像素：
#   正文 #1E1E2E（Mocha base）、目录 teal #94E2D5、可执行 red #F38BA8、tab 条 #11111B（crust）。
#   想回退：这行改回 "Rose Pine"。
# 2026-10-16：background-blur 20 → macos-glass-regular（macOS 26+ 原生玻璃）。
#   效果：标题栏不再是一层平色，而是能看到桌面透过来的玻璃；正文仍由 0.9 不透明度压住。
#   不要的话把这行改回 20。
theme            = "Catppuccin Mocha"
background-opacity = 0.9
background-blur    = macos-glass-regular
window-theme     = auto

# Option 键发送 ESC（alt 修饰）——herdr 的 prefix+alt+1..9（focus_agent）等 alt 组合键依赖此设置
macos-option-as-alt = true

# ── 窗口 ──
window-padding-x = 12
window-padding-y = 8
# 视口除不尽单元格大小时，把余量均摊到四边（默认 false，会全堆在右下）
window-padding-balance = true
# 标题栏样式选择史（2026-10-16，换样式改下面那行即可）：
#   tabs        = macOS 26/27 上把标题栏换成原生 NSToolbar，只把系统 tab 条塞进去。标题被
#                 titleVisibility=.hidden 藏掉，整条只剩一颗 ⌘2 药丸；工具栏那层深色玻璃
#                 Ghostty 压不下去（源码只压 tab 条那一小块：TransparentTitlebarTerminalWindow
#                 .swift:129 的 reduceTabBarBackgroundGoldenGate()）。
#   transparent = 标题文字回来、tab 条显示 tab 名；标题栏染上终端背景色。
#   native      = 当前选择。额外给标题前的文件夹图标（代理图标），文档写明只有 native 可见；
#                 代价是“零定制”——标题栏走系统材质，不跟随终端背景色。
# 改这行只对新窗口生效：先 ⌘⇧, 重载，再 ⌘N 开新窗口。
macos-titlebar-style = native
window-save-state = always
# herdr 场景安全：关窗口=client 脱离，server/pane 常驻；Cmd+W 秒关窗口是预期行为
confirm-close-surface = false

# ── 光标（实心不闪烁，减少眼部刺激）──
cursor-style     = bar
cursor-style-blink = false

# ── 滚动/交互 ──
# 2026-10-16：100MB → 20MB。回滚历史主要由 herdr 管（每 pane 50MB，见 herdr config.toml），
# 这里是外层 surface 的上限，Ghostty 默认值本身就是 10MB。
scrollback-limit = 20000000
scrollbar        = never
mouse-hide-while-typing = true
copy-on-select   = clipboard
shell-integration = zsh
# ssh 两项：连 unraid / VPS 时自动装并缓存 xterm-ghostty 的 terminfo，TUI 颜色/键位更正确。
# 省略的项保持默认（cursor / title / path 仍开，sudo 仍关）。
shell-integration-features = ssh-env,ssh-terminfo
# 长命令结束时发通知，只在「没有聚焦的 surface」上发（外层 shell 面有效）。
# ⚠️ action 默认值是 bell,no-notify——只响铃不通知，所以必须显式改掉。
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify

# ── 键位 ──
# 字体大小
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Quick terminal（Quake 式下拉终端）
# Quick terminal（Quake 式下拉终端）
# ⚠️ 不用 global: 前缀——ghostty 1.3.x macOS 的 global: 键位有 Mach 端口泄漏 bug
# （~1 端口/秒；按此折算连续运行约 3.5 天后被 EXC_RESOURCE SIGKILL，杀掉所有终端会话）。
# 出处是 discussion ghostty-org/ghostty#13456（不是 issue，gh issue view 13456 会 404）。
# 2026-10-16 复核：维护者 mitchellh 2026-08-05 回 “Fixed on main”，但 1.3.1 仍是最新稳定
# tag，修复未发布 → 继续用窗口内键位；等修复发布后，本行可改回
# keybind = global:ctrl+grave_accent=toggle_quick_terminal，那就能在任何 app 里唤起。
keybind = ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size     = 40%

# 注意：不再绑定 Ghostty 原生分屏（new_split）——分屏由 herdr 管理
# （prefix+v / prefix+- 或直连 ctrl+alt+d），原生分屏会在 herdr 内再套一层，布局混乱
# 2026-10-16：补 unbind。之前只是没写自己的 new_split 绑定，Ghostty 默认的
# super+d=new_split:right / super+shift+d=new_split:down 仍然生效——按 ⌘D 仍会套一层。
keybind = super+d=unbind
keybind = super+shift+d=unbind
# 也不绑定 close_surface 类键（herdr 会话关窗口用 Cmd+W，防误触整窗关闭）
