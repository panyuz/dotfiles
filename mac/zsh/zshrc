# ── 历史记录（去重、带时间戳、多会话共享）──
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
HIST_STAMPS="yyyy-mm-dd"
setopt EXTENDED_HISTORY          # 记录时间戳与时长
setopt HIST_IGNORE_ALL_DUPS      # 重复命令只保留最新一条
setopt HIST_IGNORE_SPACE         # 前导空格命令不入历史
setopt HIST_REDUCE_BLANKS        # 压缩命令中的多余空格
setopt HIST_EXPIRE_DUPS_FIRST    # 超限时先删重复项
setopt HIST_VERIFY               # 历史展开先确认再执行
setopt SHARE_HISTORY             # 多会话实时共享历史（隐含增量写入，无需 INC_APPEND_HISTORY）
setopt AUTO_CD                   # 直接输入目录名进入
setopt INTERACTIVE_COMMENTS      # 交互模式支持 # 注释

# ── Oh My Zsh ──
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                     # 提示符由 starship 渲染，OMZ 主题置空避免重复加载
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto   # 每周一次静默自动更新
zstyle ':omz:update' frequency 7
DISABLE_UNTRACKED_FILES_DIRTY="true"  # 大仓库提示符加速：不标记 untracked 为 dirty
plugins=(git)
source $ZSH/oh-my-zsh.sh

# ── 补全优化（大小写/连字符不敏感 + 菜单选择；compinit 由 OMZ 加载）──
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh"  # 目录不存在时缓存会静默失效，先确保存在
[[ -d "$HOME/.cache/zsh" ]] || mkdir -p "$HOME/.cache/zsh"
zstyle ':completion:*' group ''

# ── 现代 CLI 工具链 ──

# 1. 替代 ls (eza，带颜色和图标)
# 2026-10-16：颜色跟随主题 Catppuccin Mocha——目录 cyan(36)=#94e2d5、可执行 red(31)=#f38ba8。
# 用 ANSI 编号（不是 hex），改主题时跟着调色板走。未指定的键仍用 eza 自带默认值。
export EZA_COLORS="di=36:ex=31"
alias ls="eza --color=always --icons=always"
alias ll="eza -la --icons=always --git"
alias tree="eza --tree --icons=always"

# 2. 替代 cat (bat)
alias cat="bat"
export BAT_THEME="TwoDark"

# 3. fzf 配置 (fd 加速全局搜索)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden --exclude .git"
source <(fzf --zsh)

# 4. 替代 cd (zoxide，官方 --cmd cd 方式，cd - / cd 等语义正确)
eval "$(zoxide init --cmd cd zsh)"
alias z="cd"   # z 与 cd 等价：zoxide 智能跳转 + 完整 cd 语义

# 5. Yazi 文件管理器 (官方 y wrapper，退出后自动 cd 到浏览目录)
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# 6. Starship 提示符
eval "$(starship init zsh)"

# ── 用户 PATH（.zshenv 已用 typeset -U 对 path 去重）──

# Added by Antigravity
path=("$HOME/.antigravity/antigravity/bin" $path)

# Bun
export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)

# ── 用户别名 ──

# Surge CLI
alias surge-cli="/Applications/Surge.app/Contents/Applications/surge-cli"
alias surge-flush-dns="/Applications/Surge.app/Contents/Applications/surge-cli flush dns"

alias jp="ssh jp"
path=("$HOME/.local/bin" $path)

# ── herdr 会话标题（分清在哪个工作）── 2026-09-27
# 机制：一个「总管」进程盯着所有运行中的 herdr 会话，把外层终端标题写成
#   「会话 · 工作区 · tab · 主机名」（如 code · INVEST · 1 · panyudeMacBook-Air）。
#   它只读 session.snapshot + 写 client.window_title.set，不碰 pane / agent / 输入。
#   总管在所有会话结束后会自己退出；下一次开 shell 时下面这行会自动把它拉回来。
#   想停：pkill -f herdr-title.sh（标题会立刻交还 herdr 自带模板）
#   真源脚本（改格式/别名看它顶部注释）：comtools/scripts/herdr/herdr-title.sh
_herdr_title_ensure() {
  local title="$HOME/Documents/github/comtools/scripts/herdr/herdr-title.sh"
  [ -x "$title" ] || return 0
  pgrep -f '^([^ ]*/)?bash +[^ ]*herdr-title\.sh +watch.*--all' >/dev/null 2>&1 && return 0
  nohup "$title" watch --all >/dev/null 2>&1 &!
}
_herdr_title_ensure   # 开 shell 时检查一次（已有总管就什么都不做）

# 便捷入口（可选，不改变启动方式）：hwork code / hwork paper；不带参数 = 默认会话
hwork() {
  local s="${1:-default}"
  if [ $# -gt 0 ]; then shift; fi
  _herdr_title_ensure
  if [ "$s" = default ]; then
    herdr "$@"
  else
    herdr --session "$s" "$@"
  fi
}
